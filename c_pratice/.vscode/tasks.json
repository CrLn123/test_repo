{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C: gcc 编译当前文件",
            "command": "D:/c++/mingw64/bin/gcc.exe",
            "args": [
                "-std=c17",
                "-D__USE_MINGW_ANSI_STDIO=1",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "使用 GCC 编译当前打开的 C 源文件"
        }
    ]
}
