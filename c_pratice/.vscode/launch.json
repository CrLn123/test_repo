{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C: 编译并调试当前文件",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/c++/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "启用 GDB 格式化显示",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C: gcc 编译当前文件"
        }
    ]
}
